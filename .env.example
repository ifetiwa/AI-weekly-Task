# ── Required for production / Vercel deployment ──

# Flask secret key (generate a random string)
SECRET_KEY=change-me-to-a-random-secret

# Neon PostgreSQL connection string
# Sign up at https://neon.tech, create a project, and copy the connection string
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Fernet encryption key for stored API credentials (base64, 32-byte key)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
